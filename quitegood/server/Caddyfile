support.quitegood.be {
	encode gzip

	# RustDesk rendezvous (hbbs) over WebSocket
	handle /ws/id {
		reverse_proxy 127.0.0.1:21118
	}
	# RustDesk relay (hbbr) over WebSocket - long-lived sessions
	handle /ws/relay {
		reverse_proxy 127.0.0.1:21119 {
			flush_interval -1
			stream_timeout 24h
		}
	}
	# OSS server has no API: answer the client's API calls quietly
	handle /api/* {
		respond 404
	}
	# Fixed download links for the website -> latest GitHub release of the fork
	# (replace OWNER/REPO by the fork, e.g. quitegood/rustdesk)
	redir /download/windows     https://github.com/OWNER/REPO/releases/latest/download/QuitegoodSupport-Windows.exe 302
	redir /download/windows-msi https://github.com/OWNER/REPO/releases/latest/download/QuitegoodSupport-Windows.msi 302
	redir /download/mac         https://github.com/OWNER/REPO/releases/latest/download/QuitegoodSupport-macOS-AppleSilicon.dmg 302
	redir /download/mac-intel   https://github.com/OWNER/REPO/releases/latest/download/QuitegoodSupport-macOS-Intel.dmg 302

	# Anything else: send people to the download page
	handle {
		redir https://www.quitegood.be/support 302
	}
}
